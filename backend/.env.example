# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./vertex.db

# Security & JWT (Must be at least 16 characters)
JWT_SECRET=super-secret-vertex-jwt-key-2026-secure-random

# Token Expiry in minutes (default 8 hours = 480)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000

# API Settings
API_PREFIX=/api/v1
COMPANY_NAME=Vertex Enterprise
APP_TIMEZONE=Asia/Kolkata

# Registration & Bootstrap
ALLOW_PUBLIC_REGISTRATION=true
AUTO_CREATE_TABLES=true
